{
  "name": "origenes-sv-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del ERP y POS de Restaurante Orígenes SV",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/db-setup.js",
    "db:migrate": "node scripts/db-setup.js --solo-migraciones",
    "db:reset": "node scripts/db-reset.js",
    "test": "node --test --test-concurrency=1 \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
