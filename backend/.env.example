# Copiar a .env y completar. Nunca versionar .env.
NODE_ENV=development
PORT=3000
# Prefijo común de la API. En el frontend: VITE_API_URL=http://localhost:3000/api/v1
API_PREFIX=/api/v1
# Orígenes permitidos por CORS, separados por coma (sin "/" final)
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante_sv
DB_USER=origenes_app
DB_PASSWORD=
DB_SSL=false
DB_TIMEZONE=America/El_Salvador
# Base que usa `npm test`. Se BORRA y recrea en cada corrida: nunca apuntarla a datos reales.
DB_NAME_TEST=origenes_test

# Secretos largos y aleatorios (mínimo 32 caracteres). Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CSRF_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# En producción con HTTPS: COOKIE_SECURE=true. Si frontend y API quedan en
# sitios distintos (otro dominio), COOKIE_SAMESITE=none (exige COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
